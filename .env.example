# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Connection
DB_USER=sa
DB_PASSWORD=your_db_password
DB_SERVER=localhost
DB_DATABASE=techcycle_db
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Email Service
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=TechCycle <your_email@gmail.com>

# Authentication
JWT_SECRET=your_secret_key_change_me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# SePay Configuration
SEPAY_API_KEY=your_sepay_api_key
SEPAY_BANK_BRAND=TPBank
SEPAY_ACCOUNT_NO=your_account_no
SEPAY_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
