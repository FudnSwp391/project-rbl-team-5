# Port cấu hình cho Backend Express Server
PORT=5000

# Cấu hình kết nối SQL Server (dành cho thư viện mssql hoặc các ORM như Sequelize)
DB_USER=sa
DB_PASSWORD=admin
DB_SERVER=localhost
DB_DATABASE=techcycle_db
DB_PORT=1433

# Cấu hình chuỗi kết nối (Connection String) - Thường dùng cho Prisma, TypeORM, v.v.
DATABASE_URL=sqlserver://localhost:1433;database=techcycle_db;user=sa;password=your_strong_password;encrypt=true;trustServerCertificate=true;

# Cấu hình JWT (JSON Web Token) cho xác thực người dùng
JWT_SECRET=your_jwt_secret_key_here
